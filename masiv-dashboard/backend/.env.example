# Copy this file to `.env` and fill in your own key.
#
# Get a free Groq API key at https://console.groq.com/keys
# (Groq's free tier is fast and generous - no credit card needed.)
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default downtown Calgary bounding box used to
# pull building/permit data. Format: min_lat,min_lon,max_lat,max_lon
CALGARY_BBOX=51.0430,-114.0730,51.0480,-114.0640

# Optional: SQLite file location (relative to backend/ folder)
DATABASE_URL=sqlite:///./city_dashboard.db
